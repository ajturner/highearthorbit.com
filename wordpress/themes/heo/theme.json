{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "720px", "wideSize": "1200px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#F7F7F4" },
				{ "slug": "surface", "name": "Surface", "color": "#FFFFFF" },
				{ "slug": "tint", "name": "Tint", "color": "#EEF1F4" },
				{ "slug": "placeholder", "name": "Placeholder", "color": "#E4E6E1" },
				{ "slug": "rule", "name": "Rule", "color": "#D9DBD6" },
				{ "slug": "muted", "name": "Muted text", "color": "#5A6068" },
				{ "slug": "body", "name": "Body text", "color": "#3A3F45" },
				{ "slug": "contrast", "name": "Contrast", "color": "#16191D" },
				{ "slug": "accent", "name": "Accent", "color": "#1D4F91" },
				{ "slug": "accent-dark", "name": "Accent dark", "color": "#123462" },
				{ "slug": "warm", "name": "Warm", "color": "#B04A12" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{ "slug": "sans", "name": "IBM Plex Sans", "fontFamily": "'IBM Plex Sans', system-ui, -apple-system, sans-serif" },
				{ "slug": "mono", "name": "IBM Plex Mono", "fontFamily": "'IBM Plex Mono', ui-monospace, monospace" }
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1rem" },
				{ "slug": "large", "name": "Large", "size": "1.3125rem" },
				{ "slug": "x-large", "name": "Extra large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "1.75rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "2.75rem", "fluid": { "min": "2rem", "max": "2.75rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "2.5rem" },
				{ "slug": "60", "name": "XL", "size": "3.5rem" },
				{ "slug": "70", "name": "XXL", "size": "4.5rem" }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.6" },
		"spacing": {
			"blockGap": "1.5rem",
			"padding": { "left": "1.5rem", "right": "1.5rem" }
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent-dark)" } }
			},
			"heading": { "typography": { "fontWeight": "600", "lineHeight": "1.2", "letterSpacing": "-0.01em" } },
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "letterSpacing": "-0.02em" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } }
		},
		"blocks": {
			"core/post-title": { "elements": { "link": { "color": { "text": "var(--wp--preset--color--contrast)" } } } },
			"core/post-excerpt": { "color": { "text": "var(--wp--preset--color--body)" } },
			"core/navigation": { "typography": { "fontSize": "0.9375rem", "fontWeight": "500" }, "elements": { "link": { "color": { "text": "var(--wp--preset--color--contrast)" } } } },
			"core/separator": { "color": { "text": "var(--wp--preset--color--rule)" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": []
}
